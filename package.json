{
  "name": "rails-astryx-starter-kit",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:ssr": "vite build --ssr",
    "check": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "test:javascript": "node --test test/javascript/use-object-url.test.js",
    "lint": "eslint '*.{js,mjs,cjs,ts}' app/javascript/ test/javascript/ --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint '*.{js,mjs,cjs,ts}' app/javascript/ test/javascript/ --fix",
    "format": "prettier --check 'app/javascript' 'test/javascript' '*.{js,mjs,cjs,ts}'",
    "format:fix": "prettier --write 'app/javascript' 'test/javascript' '*.{js,mjs,cjs,ts}'"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.6.2",
    "@astryxdesign/theme-neutral": "^0.6.2",
    "@inertiajs/react": "^3.7.1",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.6.2",
    "@babel/core": "^7.29.7",
    "@eslint-react/eslint-plugin": "^5.20.5",
    "@eslint/js": "^10.0.1",
    "@inertiajs/core": "^3.7.1",
    "@inertiajs/vite": "^3.7.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rails-vite-plugin": "^0.2.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0"
  }
}
